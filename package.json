{
    "name": "twitch-channel-point-auto-claimer-react",
    "version": "1.4.0",
    "type": "module",
    "scripts": {
        "test": "bun test",
        "test:watch": "bun test --watch",
        "prebuild": "bun run test",
        "build:chrome": "BROWSER=chrome bun run scripts/build.js chrome",
        "build:firefox": "BROWSER=firefox bun run scripts/build.js firefox",
        "build": "bun run build:chrome && bun run build:firefox",
        "predev": "bun run scripts/build-theme-boot.js",
        "dev": "vite --port 5173 --strictPort --host localhost",
        "clean": "rm -rf dist-chrome dist-firefox src/content/content.js src/popup/theme-boot.js"
    },
    "dependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@vitejs/plugin-react": "^4.2.1",
        "vite": "^5.0.8"
    }
}
